# ══════════════════════════════════════════════════════════════════
# Ore Delivery — environment template
# Copy to .env and fill in your LIVE keys. Nothing here is committed.
# The backend is built so every integration reads from env at runtime —
# drop this codebase in your workspace with .env set and it just works.
# ══════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Infrastructure ──────────────────────────────────────────────────
# DB_TYPE=sqlite is supported for a zero-infra dev boot; postgres is production.
DB_TYPE=postgres
DATABASE_URL=postgres://ore:ore@localhost:5432/oredelivery
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# NATS credentials (audit S-1a). Required in production when ORCHESTRATION=distributed:
# NatsBus refuses to connect without them. The compose stack enforces the same auth.
NATS_USER=ore-bus
NATS_PASS=change-me-nats-password

# Bus envelope signing key (audit S-1c). Defaults to INTERNAL_SERVICE_KEY; set a distinct
# value to rotate event signing independently of the HTTP internal key.
ORE_BUS_SIGNING_KEY=

# HTTP throttler storage (audit S-11). Defaults to Redis whenever REDIS_URL is set, so
# limits are cluster-wide instead of per-process. Set to 'false' only for single-node dev.
USE_REDIS_THROTTLER=true

# docker compose infra credentials (audit S-2) — compose refuses to start without these.
# Only needed for `docker compose up`; ignored by a bare `pnpm dev` against local infra.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# inprocess = single-process local (no NATS/Redis needed)
# distributed = production (NATS + Redis required — services refuse to boot without them)
ORCHESTRATION=inprocess

# Optional explicit service origins for container/remote deployments.
# Local defaults use localhost and the service ports below.
CATALOG_URL=http://localhost:4101
ORDER_URL=http://localhost:4103
PAYMENT_URL=http://localhost:4104
DISPATCH_URL=http://localhost:4105
# Live tracking Socket.IO is proxied by the gateway at /api/tracking/socket.io
# (namespace /tracking). Apps must use API_BASE_URL, not TRACKING_PORT directly.

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-please-32-chars-minimum
# Access-token lifetime (audit L-2): short by default; refresh rotation covers sessions.
JWT_EXPIRES_IN=15m
# Shared secret for service-to-service /internal calls. Required in production.
# Every internal call is HMAC-signed and body-bound (x-ore-internal-mac); the plaintext
# key alone is only accepted when INTERNAL_LEGACY_KEY=on, which is refused in production.
INTERNAL_SERVICE_KEY=ore-dev-internal-key-change-me
# Allowlist of service names accepted in x-ore-service on internal calls (audit S-3).
# Empty = every name accepted. Example: gateway,order,ledger,payment
INTERNAL_CALLERS=
# Plaintext-key fallback for rolling deploys from pre-MAC builds (audit S-3). Leave unset.
# 'on' throws at boot when NODE_ENV=production.
INTERNAL_LEGACY_KEY=off
# Comma-separated browser origins. Empty = allow any origin in non-production; deny in production.
CORS_ORIGINS=
# Optional first admin. Login is email + password + TOTP. Never auto-created on login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
AUTH_OTP_TTL_MIN=10
# Dev convenience: when true, the OTP is returned in the API response. Forced off in production.
AUTH_OTP_LOG=true
# SMS provider: log (dev no-op) | twilio | hubtel
SMS_PROVIDER=log
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_FROM=OREDEL
# NOTE: the host is smsc.hubtel.com — sms.hubtel.com REJECTS real credentials (audit S-5).
HUBTEL_BASE_URL=https://smsc.hubtel.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# In-app Voice (masked). Do not reuse the SMS Auth Token as an API key.
# log = apps fall back to tel: | twilio = Access Token + TwiML <Client>
VOICE_PROVIDER=log
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
# Exact public URL Twilio should POST for the TwiML App Voice URL (signature check).
TWILIO_VOICE_WEBHOOK_URL=https://api-staging.ore.delivery/api/comms/voice/twiml
TWILIO_PUSH_CRED_ANDROID=
TWILIO_PUSH_CRED_IOS=
SUPPORT_PHONE=
VOICE_RECORD_SUPPORT=true

# ── Paystack (live keys go here) ────────────────────────────────────
# paystack.com/docs — test keys start with sk_test_, live with sk_live_
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# mock = run the whole money flow without Paystack (mock webhook endpoint);
# live = real Paystack transactions + webhooks
PAYSTACK_MODE=mock
# Currency & reference prefix
PAYSTACK_CURRENCY=GHS
PAYSTACK_REF_PREFIX=ore-cc

# ── Google Maps (all services enabled) ──────────────────────────────
GOOGLE_MAPS_API_KEY=AIza_xxxxxxxxxxxxxxxx
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# ── what3words ──────────────────────────────────────────────────────
WHAT3WORDS_API_KEY=xxxxxxxx
WHAT3WORDS_BASE_URL=https://api.what3words.com/v3

# ── Ghana GPS (national digital addressing) ─────────────────────────
GHANA_GPS_API_KEY=xxxxxxxx
GHANA_GPS_BASE_URL=https://api.ghanapostgps.com

# mock = deterministic coordinates for known test places (works offline);
# live = real calls to Google / what3words / Ghana GPS
GEOCODER_MODE=mock
# OpenStreetMap Nominatim fallback when the Google lookup fails (audit S-10). Results are
# reported with source=OPENSTREETMAP and logged loudly. false = Google failure is a hard error.
GEOCODER_OSM_FALLBACK=true

# ── Storage (doc §Media) ────────────────────────────────────────────
# local = disk storage (dev, no keys) | r2 = Cloudflare R2 (S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Push notifications ──────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_PATH=
# log = print pushes in dev (no FCM credentials needed)
FCM_MODE=log

# ── Service ports (internal) ────────────────────────────────────────
GATEWAY_PORT=4000
# Gateway edge rate limit (audit M-2) — per client IP / JWT sub, Redis-backed when REDIS_URL is set.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_PORT=4100
CATALOG_PORT=4101
CART_PORT=4102
ORDER_PORT=4103
PAYMENT_PORT=4104
DISPATCH_PORT=4105
TRACKING_PORT=4106
NOTIFICATION_PORT=4107
LEDGER_PORT=4108
ONBOARDING_PORT=4109
COMMS_PORT=4111
# Order-thread Socket.IO is proxied by the gateway at /api/comms/socket.io
# (namespace /comms). Apps must use API_BASE_URL, not COMMS_PORT directly.

# ── Business config (tune after launch) ─────────────────────────────
DISPATCH_LEAD_MIN=5
VENDOR_ACCEPT_WINDOW_SEC=120
RIDER_OFFER_WINDOW_SEC=20
PAYMENT_TIMEOUT_MIN=10
RIDER_RETRY_EVERY_SEC=30
RIDER_RETRY_MAX_MIN=5
# ── Money (ore doc §2.4 / §4) ────────────────────────────────────
# Fee policy version — stamped on every order for audit (doc §15 version-control)
FEE_POLICY_VERSION=1
# Customer delivery fee = base + per-km + category adj + surge
DELIVERY_BASE_PESEWAS=400
DELIVERY_PER_KM_PESEWAS=200
DELIVERY_SURGE_PCT=0
DELIVERY_SURGE_MULTIPLIER=1.0   # approved levels: 1.0, 1.2, 1.3, 1.5
PRIORITY_FEE_PER_KM_PESEWAS=100
# JSON map of extra customer charges per vendorType: {"MARKET":200,...}
CATEGORY_ADJUSTMENT_PESEWAS={}
# Rider fulfilment fee = base + pickup-km + delivery-km + load/handling + incentives (doc §2.4.2)
RIDER_BASE_PESEWAS=400
RIDER_PICKUP_PER_KM_PESEWAS=100
RIDER_DELIVERY_PER_KM_PESEWAS=250
LOAD_ALLOWANCE_PESEWAS={"MARKET":200,"LAUNDRY":200,"PARCEL":100}
PAYOUT_MULTIPLIER_BY_SERVICE_LEVEL={"STANDARD":1,"SCHEDULED":1,"PRIORITY":1.15}
CANCELLATION_TREATMENT_JSON={"BEFORE_VENDOR_ACCEPT_CUSTOMER_FEE_PCT":0,"AFTER_VENDOR_ACCEPT_CUSTOMER_FEE_PCT":25,"AFTER_PICKUP_CUSTOMER_FEE_PCT":100,"VENDOR_FAULT_CUSTOMER_FEE_PCT":0,"VENDOR_FAULT_VENDOR_COMMISSION_PCT":0,"RIDER_FAULT_RIDER_PAYOUT_PCT":0}
COMMISSION_BY_TYPE_JSON={"FOOD":18,"GROCERY":12,"MARKET":10,"PHARMACY":10,"SHOP":12,"LAUNDRY":12,"PARCEL":0,"ERRAND":0}
# Platform-funded rider peak pay. Empty JSON array / blank = off. Not a customer charge.
# Example: [{"title":"Lunch rush","amountPesewas":300,"startsAt":"2026-08-19T11:00:00.000Z","endsAt":"2026-08-19T14:00:00.000Z","centerLat":5.105,"centerLng":-1.247,"radiusMeters":4000}]
PEAK_PAY_WINDOWS_JSON=
SERVICE_FEE_PCT=2
SERVICE_FEE_WAIVE_ABOVE_PESEWAS=49900
# Tax engine: rates live in ledger.tax_rule; pricing mode controls whether Ore-owned fees are tax-inclusive extraction or tax-exclusive add-on.
ORE_TAX_PRICING_MODE=INCLUSIVE
ORE_DELIVERY_MARGIN_REVENUE_ENABLED=true
# Per-category vendor commission lives in libs/contracts/src/enums.ts (doc schedule)

# ── Dispatch (ore doc §2) ─────────────────────────────────────────
DISPATCH_POOL_RADIUS_KM=2
DISPATCH_EXPAND_STEP_KM=2
DISPATCH_MAX_RADIUS_KM=10
DISPATCH_WAVE_SIZE=3
MULTI_VENDOR_GROUPING_THRESHOLD_MIN=10
DISPATCH_ROUTE_MAX_EXTRA_KM=3
DISPATCH_EXCLUDE_TIMEOUTS=true
# Lower score wins. Keys: distance,idleTime,reliability,rating,declinePenalty,timeoutPenalty,vehicleSuitability,pickupEta
DISPATCH_SCORING_WEIGHTS_JSON=
RIDER_DECLINE_COOLDOWN_AFTER=5
RIDER_COOLDOWN_MIN=5
# Cart checkout: minutes of slack added to vendor prep time when quoting a delivery window.
PACKING_BUFFER_MIN=2
# Parcel (doc §Parcel) flat platform service fee.
PARCEL_SERVICE_FEE_PESEWAS=500
# Vendor SLA (doc §2 / §6): accept within 3 min, auto-cancel at 5 min
VENDOR_ACCEPT_SLA_SEC=180
VENDOR_AUTO_CANCEL_SEC=300
PICKUP_GEOFENCE_M=100
DROP_GEOFENCE_M=150

# ── Wallet / rider money (doc §5) ───────────────────────────────────
RIDER_WITHDRAW_MIN_PESEWAS=5000          # min payout GHS 50
RIDER_WITHDRAW_DAILY_CAP_PESEWAS=200000  # daily payout cap GHS 2,000
RIDER_WITHDRAW_FEE_PESEWAS=200           # GHS 2 after the free payout
RIDER_WITHDRAW_FREE_PER_DAY=1            # 1 free payout per day
RIDER_CLEAR_HOURS=24                     # earnings clear (pending→available) after 24h
RIDER_CLEAR_CHECK_INTERVAL_MIN=10
COD_REMIT_TRIGGER_PCT=90                 # remit at 90% of COD tier limit
COD_UNBLOCK_PCT=70                       # auto-resume below 70% (hysteresis)
CUSTOMER_COD_TIER_NEW_LIMIT_PESEWAS=20000
CUSTOMER_COD_TIER_STANDARD_LIMIT_PESEWAS=50000
CUSTOMER_COD_TIER_TRUSTED_LIMIT_PESEWAS=150000
CUSTOMER_COD_TIER_PREMIUM_LIMIT_PESEWAS=300000
COD_TIER_NEW_LIMIT_PESEWAS=100000        # GHS 1,000
COD_TIER_EXPERIENCED_LIMIT_PESEWAS=300000 # GHS 3,000
COD_TIER_SENIOR_LIMIT_PESEWAS=500000     # GHS 5,000
RIDER_TIER_EXPERIENCED_DELIVERIES=50
RIDER_TIER_SENIOR_DELIVERIES=200
COD_ESCALATE_CHECK_INTERVAL_MIN=30
COD_ESCALATE_WARNING_H=24                # 24h overdue → warning (SMS)
COD_ESCALATE_SUSPEND_H=48                # 48h → COD suspension
COD_ESCALATE_INVESTIGATE_H=72            # 72h → investigation (offline)
COD_ESCALATE_TERMINATE_H=73              # >72h → termination (doc: ">72 h termination")

# ── Vendor settlement (doc §4) ──────────────────────────────────────
VENDOR_MIN_SETTLEMENT_PESEWAS=10000    # min settlement GHS 100, below → rolls over
VENDOR_DAILY_CAP_PESEWAS=1000000       # daily payout cap GHS 10,000 (larger payouts chunk)
VENDOR_RESERVE_PCT=10                  # rolling reserve held on each settlement
VENDOR_SETTLE_DAY=1                    # 1 = Monday (settlement day, UTC)
VENDOR_SETTLE_CHECK_INTERVAL_MIN=360   # scheduler checks for the Monday window every 6h

# ── Dispatch grouping / batching (doc §2) ───────────────────────────
DISPATCH_GROUPING=true              # group same-checkout vendors / batch route-compatible customers
GROUP_MAX_VENDORS=3                 # max vendors in one grouped pickup (doc: group under 10-min threshold)
GROUP_VENDOR_DISTANCE_KM=2.5        # vendors must be within this to group
BATCH_MAX_ORDERS=3                  # multi-customer batch cap (doc §2: 2–3 at launch)
BATCH_VENDOR_DISTANCE_KM=2.0        # batch vendors within this of each other
BATCH_DROP_DISTANCE_KM=1.5          # batch drops within this of each other
GROUP_JOIN_WINDOW_MS=1500          # ms after READY before dispatch — lets sibling vendors join a group
RIDER_DEFAULT_SESSION_MIN=240      # server-authoritative online session duration (4h)
# Optional scheduled dashes. Going online without a block still works.
RIDER_BLOCK_MIN_MIN=30
RIDER_BLOCK_MAX_MIN=480            # 8h cap
RIDER_BLOCK_MAX_DAYS_AHEAD=7
RIDER_BLOCK_MAX_OPEN=14
RIDER_BLOCK_GRACE_MIN=30           # unstarted SCHEDULED dash is dropped after this
RIDER_DEMAND_CELL_KM=1.5           # fallback demand-cell width; configured zones may override this
RIDER_DEMAND_MAX_DISTANCE_KM=8     # maximum distance for Rider positioning cards
# Optional JSON: [{"zoneId":"...","zoneName":"...","centerLat":5.1,"centerLng":-1.25,"radiusMeters":900}]
RIDER_DEMAND_ZONES_JSON=

# ── Errands (doc §Errands) ──────────────────────────────────────────
ERRAND_FEE_PESEWAS=1000            # flat platform fee per errand (GHS 10)
ERRAND_TIER_NEW_LIMIT_PESEWAS=30000      # new rider errand carrying cap GHS 300
ERRAND_TIER_VERIFIED_LIMIT_PESEWAS=100000 # verified GHS 1,000
ERRAND_TIER_TRUSTED_LIMIT_PESEWAS=300000  # trusted GHS 3,000
ERRAND_TIER_CAP_LIMIT_PESEWAS=500000      # cap GHS 5,000
ERRAND_TIER_VERIFIED_DELIVERIES=10
ERRAND_TIER_TRUSTED_DELIVERIES=50
ERRAND_TIER_CAP_DELIVERIES=100
GIFT_BASE_URL=http://localhost:4000   # base for gift confirm links (SMS to recipient)
MUX_TOKEN_ID=                         # Mux access token (vendor story videos; mock uses playback id passthrough)
MUX_TOKEN_SECRET=
MUX_MODE=mock

# ── SmileID Document Verification (server-side only) ────────────────
# Credentials are never shipped to Flutter.
PARTNER_ID=
API_KEY=
PRODUCTION_API_KEY=
SMILE_ENV=sandbox
SMILE_BASE_URL=https://testapi.smileidentity.com
SMILE_PRODUCT=document_verification
CALLBACK_URL=
SMILE_WEBHOOK_SECRET=
SMILE_WEBHOOK_SIGNATURE_HEADER=x-smile-signature
