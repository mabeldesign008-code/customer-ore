{
  "name": "catalog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/catalog/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "commands": ["tsc -p tsconfig.build.json"] }
    },
    "serve": { "executor": "nx:run-commands", "options": { "cwd": "{projectRoot}", "command": "ts-node -P tsconfig.json src/main.ts" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "cwd": "{projectRoot}", "command": "tsc -p tsconfig.json --noEmit" } },
    "test": { "executor": "nx:run-commands", "options": { "cwd": "{projectRoot}", "command": "jest --config jest.config.cjs" } }
  }
}
