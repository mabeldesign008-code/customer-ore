# Ore Customer - Environment Variables Example
# Copy to .env and fill values. NEVER commit .env with real keys.
# `--dart-define=API_BASE_URL=...` overrides this file.

# API gateway origin (no trailing slash)
API_BASE_URL=https://api-staging.ore.delivery
API_STAGING_URL=https://api-staging.ore.delivery
FLAVOR=development

# Google Maps - Get from https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# How to run:
# flutter run --dart-define=GOOGLE_MAPS_API_KEY=YOUR_KEY --dart-define=FLAVOR=development --dart-define=API_BASE_URL=https://api-staging.ore.delivery
#
# Or with this env file (loaded in main.dart):
# flutter run
