# ── Ore Customer App environment ────────────────────────────────
# Copy to .env and fill values. .env is bundled as an asset and read
# via flutter_dotenv at startup. For production CI, prefer
# --dart-define over committing this file.

# API gateway base URL (no trailing slash).
# Android emulator: http://10.0.2.2:4000
# iOS simulator / desktop: http://localhost:4000
# Staging: https://api-staging.ore.delivery
# Production: https://api.ore.delivery
API_BASE_URL=https://api-staging.ore.delivery

# Google Maps / Places API key (also configured server-side as a
# fallback, but a restricted Android/iOS key improves autocomplete
# latency). Leave blank to use server proxy only.
GOOGLE_MAPS_API_KEY=

# One of: development | staging | production
FLAVOR=development
