# Rider configuration.
# `--dart-define=API_BASE_URL=...` overrides this file. Do not commit real keys.
API_BASE_URL=https://api-staging.ore.delivery
GOOGLE_MAPS_API_KEY=your-restricted-google-maps-key
FLAVOR=development

# Native Maps key (in addition to --dart-define, which the Directions HTTP client uses):
#   android/local.properties  →  GOOGLE_MAPS_API_KEY=...
#   ios/Flutter/Maps.xcconfig →  copy from Maps.xcconfig.example
#
# Firebase (local only — do not commit):
#   android/app/google-services.json     ← copy from google-services.json.example
#   ios/Runner/GoogleService-Info.plist  ← copy from GoogleService-Info.plist.example
# The Google Services Gradle plugin applies only when the Android file exists,
# so `nx run rider:build-apk` still works without Firebase secrets.
#
# Example:
# flutter run \
#   --dart-define=API_BASE_URL=https://api-staging.ore.delivery \
#   --dart-define=GOOGLE_MAPS_API_KEY=your-restricted-google-maps-key
