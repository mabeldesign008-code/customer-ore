{
  "name": "rider",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rider/lib",
  "tags": ["scope:mobile", "type:app", "platform:flutter"],
  "targets": {
    "pub-get": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter pub get",
        "cwd": "{projectRoot}"
      }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter analyze .",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/lib/**/*", "{projectRoot}/test/**/*"],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "flutter test",
        "cwd": "{projectRoot}"
      }
    },
    "build-web": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/lib/**/*", "{projectRoot}/web/**/*", "{projectRoot}/pubspec.yaml"],
      "outputs": ["{projectRoot}/build/web"],
      "options": {
        "command": "flutter build web --release",
        "cwd": "{projectRoot}"
      }
    },
    "build-apk": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/lib/**/*", "{projectRoot}/android/**/*", "{projectRoot}/pubspec.yaml"],
      "outputs": ["{projectRoot}/build/app/outputs/flutter-apk"],
      "options": {
        "command": "flutter build apk --release",
        "cwd": "{projectRoot}"
      }
    },
    "build-ipa": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/lib/**/*", "{projectRoot}/ios/**/*", "{projectRoot}/pubspec.yaml"],
      "outputs": ["{projectRoot}/build/ios"],
      "options": {
        "command": "flutter build ipa --release --no-codesign",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter run -d web-server --web-port=4201 --web-hostname=0.0.0.0",
        "cwd": "{projectRoot}"
      }
    }
  }
}
