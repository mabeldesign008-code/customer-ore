{
  "name": "seed",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/seed/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.build.json"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file=../../.env -r ts-node/register/transpile-only src/run.ts",
        "cwd": "{projectRoot}",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
