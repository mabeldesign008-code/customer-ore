{
  "name": "ore-delivery",
  "version": "0.1.0",
  "private": true,
  "description": "Ore Delivery — on-demand delivery platform for Cape Coast, Ghana. NestJS + Fastify microservices, Nx + pnpm monorepo.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "nx run-many -t serve --parallel=10",
    "dev:backend": "nx run-many -t serve --projects=gateway,analytics,auth,catalog,cart,order,payment,dispatch,tracking,notification,ledger,onboarding,referral,comms --parallel=15",
    "dev:gateway": "nx serve gateway",
    "dev:customer": "nx serve customer",
    "dev:rider": "nx serve rider",
    "dev:vendor": "nx serve vendor",
    "dev:admin": "nx serve admin",
    "build": "nx run-many -t build",
    "build:backend": "nx run-many -t build --projects=gateway,analytics,auth,catalog,cart,order,payment,dispatch,tracking,notification,ledger,onboarding,referral,comms,bus,config,contracts,core,db,geo,jobs,maps,notify,twilio-voice,paystack,seed,storage",
    "build:flutter:web": "nx run-many -t build-web --projects=customer,rider,vendor",
    "build:flutter:apk": "nx run-many -t build-apk --projects=customer,rider,vendor",
    "test": "nx run-many -t test",
    "test:backend": "nx run-many -t test --projects=auth,cart,catalog,comms,dispatch,gateway,ledger,notification,order,payment,tracking,onboarding,referral",
    "test:backend:coverage": "nx run-many -t test --projects=auth,cart,catalog,comms,dispatch,gateway,ledger,notification,order,payment,tracking,onboarding,referral -- --coverage",
    "test:libs": "nx run-many -t test --projects=contracts,paystack,storage,geo,twilio-voice",
    "test:flutter": "nx run-many -t test --projects=customer,rider,vendor,ore_core",
    "typecheck": "nx run-many -t typecheck",
    "flutter:pub-get": "nx run-many -t pub-get --projects=customer,rider,vendor,ore_core",
    "flutter:analyze": "nx run-many -t analyze --projects=customer,rider,vendor,ore_core",
    "seed": "nx run seed:seed",
    "nx": "nx",
    "e2e": "node scripts/e2e.mjs",
    "reset:dispatch": "node scripts/reset-dispatch.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.30",
    "concurrently": "^10.0.4",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "nx": "^23.0.0",
    "pg": "^8.23.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.13",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.35.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/profiling-node",
      "better-sqlite3",
      "msgpackr-extract",
      "nx",
      "sqlite3",
      "unrs-resolver",
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@nest-lab/throttler-storage-redis": "^1.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@sentry/nestjs": "^8.45.0",
    "@sentry/node": "^8.45.0",
    "@sentry/profiling-node": "^8.45.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.0.0",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "sqlite3": "^5.1.7",
    "typeorm-transactional": "^0.5.0"
  }
}