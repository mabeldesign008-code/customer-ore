{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ore/contracts": ["libs/contracts/src/index.ts"],
      "@ore/config": ["libs/config/src/index.ts"],
      "@ore/db": ["libs/db/src/index.ts"],
      "@ore/geo": ["libs/geo/src/index.ts"],
      "@ore/paystack": ["libs/paystack/src/index.ts"],
      "@ore/bus": ["libs/bus/src/index.ts"],
      "@ore/jobs": ["libs/jobs/src/index.ts"],
      "@ore/maps": ["libs/maps/src/index.ts"],
      "@ore/notify": ["libs/notify/src/index.ts"],
      "@ore/twilio-voice": ["libs/twilio-voice/src/index.ts"],
      "@ore/core": ["libs/core/src/index.ts"],
      "@ore/seed": ["libs/seed/src/index.ts"],
      "@ore/storage": ["libs/storage/src/index.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
